version: '3.8'
networks:
  agri_net:
    driver: bridge

services:
  zookeeper:
    image: confluentinc/cp-zookeeper:7.5.0
    container_name: zookeeper
    environment:
      ZOOKEEPER_CLIENT_PORT: 2181
      ZOOKEEPER_TICK_TIME: 2000
    networks: [agri_net]

  kafka:
    image: confluentinc/cp-kafka:7.5.0
    container_name: kafka
    depends_on: [zookeeper]
    ports: ["9092:9092"]
    environment:
      KAFKA_BROKER_ID: 1
      KAFKA_ZOOKEEPER_CONNECT: zookeeper:2181
      KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://localhost:9092
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
    networks: [agri_net]

  namenode:
    image: bde2020/hadoop-namenode:2.0.0-hadoop3.2.1-java8
    container_name: namenode
    ports: ["9870:9870", "9000:9000"]
    environment:
      CLUSTER_NAME: agri_cluster
    volumes:
      - ../data/hdfs/namenode:/hadoop/dfs/name
    networks: [agri_net]

  datanode:
    image: bde2020/hadoop-datanode:2.0.0-hadoop3.2.1-java8
    container_name: datanode
    depends_on: [namenode]
    environment:
      CLUSTER_NAME: agri_cluster
    volumes:
      - ../data/hdfs/datanode:/hadoop/dfs/data
    networks: [agri_net]

  hive-metastore:
    image: apache/hive:3.1.3
    container_name: hive-metastore
    depends_on: [namenode]
    ports: ["10000:10000"]
    environment:
      SERVICE_NAME: metastore
    volumes:
      - ../scripts/hive_setup.sql:/opt/hive/scripts/hive_setup.sql
    networks: [agri_net]

  hbase:
    image: harisekhon/hbase:2.4.9
    container_name: hbase
    ports: ["16010:16010", "9090:9090"]
    networks: [agri_net]

  nifi:
    image: apache/nifi:1.25.0
    container_name: nifi
    ports: ["8081:8080"]
    environment:
      NIFI_WEB_HTTP_PORT: 8080
      NIFI_SENSITIVE_PROPS_KEY: 'agri_sensitive_key'
    volumes:
      - ../nifi_templates:/opt/nifi/nifi-current/templates
    networks: [agri_net]

  spark-master:
    image: bitnami/spark:3.5.1
    container_name: spark-master
    environment:
      SPARK_MODE: master
      SPARK_MASTER_HOST: spark-master
    ports: ["8080:8080", "7077:7077"]
    volumes:
      - ../scripts:/opt/scripts
      - ../models:/opt/models
    networks: [agri_net]

  spark-worker:
    image: bitnami/spark:3.5.1
    container_name: spark-worker
    environment:
      SPARK_MODE: worker
      SPARK_MASTER_URL: spark://spark-master:7077
    depends_on: [spark-master]
    volumes:
      - ../scripts:/opt/scripts
    networks: [agri_net]

  airflow:
    image: apache/airflow:2.7.3
    container_name: airflow
    depends_on: [spark-master]
    ports: ["8082:8080"]
    environment:
      AIRFLOW__CORE__EXECUTOR: LocalExecutor
    volumes:
      - ../dags:/opt/airflow/dags
      - ../scripts:/opt/airflow/scripts
    networks: [agri_net]
